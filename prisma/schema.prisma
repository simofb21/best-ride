generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           Int       @id @default(autoincrement())
  email                        String    @unique
  firstName                    String
  lastName                     String
  weightKg                     Decimal?  @db.Decimal(5, 2)
  ftp                          Int?
  anaerobicThreshold           Int?
  yearlyDistanceKm             Decimal?  @db.Decimal(8, 2)
  yearlyHours                  Decimal?  @db.Decimal(6, 1)
  trainingStress               Int       @default(0)
  trainingStressActivityCount  Int       @default(0)
  trainingStressStartedAt      DateTime?
  trainingStressLastActivityAt DateTime?
  trainingStressResetAt        DateTime?
  sex                          String?   @db.VarChar(1)
  dateOfBirth                  DateTime? @db.Date
  privacyAcceptedAt            DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  accounts            Account[]
  activities          Activity[]
  lastActivity        LastActivity?
  pendingActivity     PendingActivity?
  processedActivities ProcessedActivity[]
  customRecords       CustomRecord[]

  recordPeakPower RecordPeakPower[]
  record3s        Record3s[]
  record5s        Record5s[]
  record10s       Record10s[]
  record20s       Record20s[]
  record30s       Record30s[]
  record1min      Record1min[]
  record2min      Record2min[]
  record3min      Record3min[]
  record5min      Record5min[]
  record8min      Record8min[]
  record10min     Record10min[]
  record12min     Record12min[]
  record15min     Record15min[]
  record20min     Record20min[]
  record30min     Record30min[]
  record60min     Record60min[]

  recordDistance      RecordDistance[]
  recordElevationGain RecordElevationGain[]
  recordDuration      RecordDuration[]
  recordKilojoules    RecordKilojoules[]
  recordMaxCadence    RecordMaxCadence[]
  recordMaxSpeed      RecordMaxSpeed[]
  recordMaxHeartrate  RecordMaxHeartrate[]
  recordHr5min        RecordHr5min[]
  recordHr20min       RecordHr20min[]
  recordHr1h          RecordHr1h[]

  @@map("users")
}

model Account {
  id         Int      @id @default(autoincrement())
  userId     Int
  provider   String // "google", in futuro "apple", ecc.
  providerId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("accounts")
}

model LastActivity {
  id                     Int       @id @default(autoincrement())
  userId                 Int       @unique
  filename               String
  uploadedAt             DateTime  @default(now())
  ftpUsed                Int
  anaerobicThresholdUsed Int
  data                   Json
  sourceId               String?
  activityId             Int?      @unique
  aiAnalysis             Json?
  aiAnalysisHash         String?
  aiAnalysisStatus       String?
  aiAnalysisModel        String?
  aiAnalysisGeneratedAt  DateTime?
  aiAnalysisStartedAt    DateTime?
  aiAnalysisAttemptCount Int       @default(0)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity? @relation("LastActivityHistory", fields: [activityId], references: [id], onDelete: SetNull)

  @@map("last_activity")
}

model Activity {
  id           Int      @id @default(autoincrement())
  userId       Int
  sourceId     String   @db.VarChar(64)
  name         String   @db.VarChar(120)
  filename     String   @db.VarChar(255)
  activityDate DateTime
  uploadedAt   DateTime @default(now())

  // Athlete feedback. Legacy backfill intentionally leaves RPE null; new
  // writes are validated as 1..10 by the API and by a database CHECK.
  perceivedExertion Int?    @db.SmallInt
  notes             String? @db.VarChar(800)

  durationSeconds           Int
  distanceMeters            Int
  elevationGainMeters       Int
  avgSpeedDeciKmh           Int?
  maxSpeedDeciKmh           Int?
  avgPowerWatts             Int?
  maxPowerWatts             Int?
  normalizedPowerWatts      Int?
  avgCadenceRpm             Int?
  maxCadenceRpm             Int?
  avgHeartRateBpm           Int?
  maxHeartRateBpm           Int?
  kilojoules                Int?
  caloriesKcal              Int?
  avgTemperatureDeciCelsius Int?
  trainingStress            Int?
  intensityFactorMilli      Int?
  ftpUsed                   Int
  anaerobicThresholdUsed    Int
  weightDeciKg              Int? @db.SmallInt

  // Version 1 array/tuple layouts are documented in the accompanying
  // migration. Keeping them positional avoids repeated JSON keys per ride.
  powerCurveWatts      Int[]
  powerZoneSeconds     Int[]
  heartRateZoneSeconds Int[]
  laps                 Json?
  recordAchievements   Json?
  trendFeatures        Json?
  sensorMask           Int   @default(0) @db.SmallInt
  calculationFlags     Int   @default(0) @db.SmallInt
  archiveSchemaVersion Int   @default(1) @db.SmallInt

  aiAnalysis             Json?
  aiAnalysisHash         String?
  aiAnalysisStatus       String?
  aiAnalysisModel        String?
  aiAnalysisGeneratedAt  DateTime?
  aiAnalysisStartedAt    DateTime?
  aiAnalysisAttemptCount Int       @default(0)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastActivity LastActivity? @relation("LastActivityHistory")

  @@unique([userId, sourceId])
  @@index([userId, activityDate(sort: Desc)])
  @@index([userId, name])
  @@map("activities")
}

model PendingActivity {
  userId    Int      @id
  sourceId  String
  filename  String
  data      Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pending_activities")
}

model ProcessedActivity {
  userId      Int
  sourceId    String
  processedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sourceId])
  @@map("processed_activities")
}

model CustomRecord {
  id            Int      @id @default(autoincrement())
  userId        Int
  slug          String
  label         String
  unit          String
  lowerIsBetter Boolean  @default(false)
  createdAt     DateTime @default(now())
  entries       Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@map("custom_records")
}

